# -----------------------------------------------------------------------------
# Copy to `.env.local` and fill in values. Never commit real secrets.
# Full list: `.cursorrules` (section 10 — Environment variables).
# -----------------------------------------------------------------------------

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Bearer secret for scheduled GET /api/cron/* routes (Netlify, cron-job.org, DO, etc.).
# Used by email-sequence and partner monthly credit sync — see CRON_SETUP.md.
CRON_SECRET=

# Upstash Redis (rate limiting on critical API routes). Create a Redis database at https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Error monitoring (optional but recommended for production)
SENTRY_DSN=
