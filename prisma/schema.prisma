datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  // Netlify serverless (Linux / OpenSSL 3) needs an engine besides local macOS `native`
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

// ─── ADMIN CONFIG (singleton row id = "default") ──

model AdminAppSettings {
  id        String   @id
  payload   Json     @default("{}")
  updatedAt DateTime @updatedAt

  @@map("admin_app_settings")
}

model ClinicLead {
  id         String   @id @default(uuid()) @db.Uuid
  fullName   String
  role       String
  clinicName String
  city       String
  teamSize   String
  interests  String[]
  whatsapp   String
  source     String   @default("landing_page")
  contacted  Boolean  @default(false)
  notes      String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([contacted])
  @@map("clinic_leads")
}

// ─── SHARED ───────────────────────────────────────

model SharedProfile {
  id        String   @id @db.Uuid
  role      String // patient | therapist | admin
  fullName  String
  phone     String?
  status    String   @default("active") // active | inactive | suspended
  /** User dismissed the guest-merge welcome banner */
  guestMergeCompleted Boolean @default(false)
  /** Guest rows were merged; show one-time banner until dismissed */
  guestMergeBannerPending Boolean @default(false)
  guestMergeSessionCount   Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  therapist TherapyTherapist?
  patient   TherapyPatient?

  @@map("shared_profiles")
}

// ─── THERAPISTS ───────────────────────────────────

model TherapyTherapist {
  id              String   @id @default(uuid()) @db.Uuid
  profileId       String   @unique @db.Uuid
  bio             String?
  specializations String[]
  qualifications  String[]
  profilePhoto    String?
  status          String   @default("pending") // pending | approved | rejected | suspended
  sessionRate     Decimal  @default(20000) @db.Decimal(10, 2)
  sessionDuration Int      @default(50) // 50 | 60 | 90 — set by admin only
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  profile               SharedProfile                 @relation(fields: [profileId], references: [id])
  availabilitySchedule  TherapyAvailabilitySchedule[]
  availabilityOverrides TherapyAvailabilityOverride[]
  bookings              TherapyBooking[]
  sessions              TherapySession[]
  notes                 TherapySessionNote[]
  rebookingRequests     TherapyRebookingRequest[]
  chatThreads           ChatThread[]
  earningsConfig        EarningsConfig?
  sessionPackages       TherapySessionPackage[]

  @@map("therapy_therapists")
}

// ─── PATIENTS ─────────────────────────────────────

model TherapyPatient {
  id          String    @id @default(uuid()) @db.Uuid
  profileId   String?   @unique @db.Uuid // null for guests
  fullName    String
  email       String
  phone       String
  dateOfBirth DateTime?
  gender      String?
  occupation  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  profile        SharedProfile?             @relation(fields: [profileId], references: [id])
  bookings       TherapyBooking[]
  credits        TherapyCredit?
  transactions   TherapyCreditTransaction[]
  medicalHistory TherapyMedicalHistory?
  rebookingRequests TherapyRebookingRequest[]
  chatThreads       ChatThread[]
  chatConsents      ChatConsent[]
  sessionPackages   TherapySessionPackage[]

  @@map("therapy_patients")
}

model TherapyMedicalHistory {
  id                 String   @id @default(uuid()) @db.Uuid
  patientId          String   @unique @db.Uuid
  currentMedications String?
  allergies          String?
  previousDiagnoses  String?
  previousTherapy    String?
  familyMedical      String?
  familyPsychiatric  String?
  familySubstanceUse String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  patient TherapyPatient @relation(fields: [patientId], references: [id])

  @@map("therapy_medical_history")
}

// ─── AVAILABILITY ─────────────────────────────────

model TherapyAvailabilitySchedule {
  id                     String   @id @default(uuid()) @db.Uuid
  therapistId            String   @db.Uuid
  dayOfWeek              Int // 0=Mon 1=Tue ... 6=Sun
  startTime              String // "09:00"
  endTime                String // "17:00"
  sessionDurationMinutes Int      @default(50)
  bufferMinutes          Int      @default(0)
  bookingWindowWeeks     Int      @default(4)
  minimumNoticeHours     Int      @default(2)
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  therapist TherapyTherapist @relation(fields: [therapistId], references: [id])

  @@map("therapy_availability_schedules")
}

model TherapyAvailabilityOverride {
  id          String   @id @default(uuid()) @db.Uuid
  therapistId String   @db.Uuid
  date        DateTime
  isBlocked   Boolean  @default(true)
  startTime   String?
  endTime     String?
  reason      String?
  createdAt   DateTime @default(now())

  therapist TherapyTherapist @relation(fields: [therapistId], references: [id])

  @@map("therapy_availability_overrides")
}

// ─── BOOKINGS ─────────────────────────────────────

model TherapyBooking {
  id                String    @id @default(uuid()) @db.Uuid
  therapistId       String    @db.Uuid
  patientId         String?   @db.Uuid // null for guests
  guestName         String?
  guestEmail        String?
  guestPhone        String?
  guestBookingReason String?
  professionalType  String?
  isAnonymous       Boolean   @default(false)
  clientAlias       String? // therapist-facing alias when isAnonymous
  date              DateTime
  startTime         String
  endTime           String
  agoraRoomId       String?
  agoraRoomToken    String?
  status            String    @default("pending") // pending | confirmed | completed | cancelled
  consentConfirmed  Boolean   @default(false)
  consentTimestamp  DateTime?
  paystackReference String?
  paymentStatus     String    @default("pending") // pending | paid | refunded | package_credit
  packageId         String?   @db.Uuid
  sessionType       String    @default("followup") // intake | followup
  paidWithCredits   Boolean   @default(false)
  reminder24hSent   Boolean   @default(false)
  reminder1hSent    Boolean   @default(false)
  cancellationReason String?
  cancelledBy        String? // client | therapist | admin | platform
  cancelledAt        DateTime?
  rescheduleCount    Int       @default(0)
  lastRescheduledAt  DateTime?
  discountCode       String?
  discountAmount     Decimal?  @db.Decimal(10, 2)
  referralCode       String?
  referralPartnerId  String?   @db.Uuid
  isReferral         Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  therapist TherapyTherapist @relation(fields: [therapistId], references: [id])
  patient   TherapyPatient?  @relation(fields: [patientId], references: [id])
  session              TherapySession?
  rebookingRequestLink TherapyRebookingRequest?
  discountCodeUses   DiscountCodeUse[]
  referralPartner    ReferralPartner? @relation(fields: [referralPartnerId], references: [id])
  referralSession    ReferralSession?
  package            TherapySessionPackage? @relation(fields: [packageId], references: [id])

  @@map("therapy_bookings")
}

model TherapySessionPackage {
  id                String   @id @default(uuid()) @db.Uuid
  patientId         String   @db.Uuid
  therapistId       String   @db.Uuid
  packageType       String // single | package_4 | package_6 | package_8
  totalSessions     Int
  usedSessions      Int      @default(0)
  remainingSessions Int
  pricePerSession   Decimal  @db.Decimal(10, 2)
  totalPaid         Decimal  @db.Decimal(10, 2)
  discountPercent   Int      @default(0)
  paystackReference String?
  status            String   @default("active") // active | exhausted | expired | refunded
  expiresAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  patient   TherapyPatient   @relation(fields: [patientId], references: [id])
  therapist TherapyTherapist @relation(fields: [therapistId], references: [id])
  bookings  TherapyBooking[]

  @@index([patientId, status])
  @@index([therapistId, status])
  @@map("therapy_session_packages")
}

// ─── SESSIONS ─────────────────────────────────────

model TherapySession {
  id               String    @id @default(uuid()) @db.Uuid
  bookingId        String    @unique @db.Uuid
  therapistId      String    @db.Uuid
  patientId        String?   @db.Uuid
  sessionNumber    Int       @default(1)
  startedAt        DateTime?
  endedAt          DateTime?
  durationMinutes  Int?
  format           String    @default("telehealth") // telehealth | in-person
  status           String    @default("scheduled") // scheduled | in-progress | completed | no-show | cancelled
  agoraTranscript  String? // deleted after note generation
  notesGenerated   Boolean   @default(false)
  notesGeneratedAt DateTime?
  generatedBy      String? // claude | deepseek (internal only)
  therapistEarnings Decimal? @db.Decimal(10, 2)
  platformEarnings  Decimal? @db.Decimal(10, 2)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  booking   TherapyBooking      @relation(fields: [bookingId], references: [id])
  therapist TherapyTherapist    @relation(fields: [therapistId], references: [id])
  note      TherapySessionNote?
  feedbacks TherapyFeedback[]

  @@map("therapy_sessions")
}

// ─── NOTES ────────────────────────────────────────

model TherapySessionNote {
  id          String    @id @default(uuid()) @db.Uuid
  sessionId   String    @unique @db.Uuid
  therapistId String    @db.Uuid
  noteType    String // soap | intake
  noteContent String // encrypted JSON
  isEdited    Boolean   @default(false)
  editedAt    DateTime?
  pdfUrl      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  session   TherapySession   @relation(fields: [sessionId], references: [id])
  therapist TherapyTherapist @relation(fields: [therapistId], references: [id])

  @@map("therapy_session_notes")
}

// ─── CREDITS ──────────────────────────────────────

model TherapyCredit {
  id        String   @id @default(uuid()) @db.Uuid
  patientId String   @unique @db.Uuid
  balance   Decimal  @default(0) @db.Decimal(10, 2)
  tier      String   @default("bronze") // bronze | silver | gold | platinum
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient TherapyPatient @relation(fields: [patientId], references: [id])

  @@map("therapy_credits")
}

model TherapyCreditTransaction {
  id        String   @id @default(uuid()) @db.Uuid
  patientId String   @db.Uuid
  amount    Decimal  @db.Decimal(10, 2) // positive = purchase, negative = used
  type      String // purchase | session | refund | admin_grant
  reference String?
  createdAt DateTime @default(now())

  patient TherapyPatient @relation(fields: [patientId], references: [id])

  @@map("therapy_credit_transactions")
}

// ─── FEEDBACK ─────────────────────────────────────

model TherapyFeedback {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @db.Uuid
  rating    Int // 1-5
  mood      String? // 😞 😐 🙂 😊 😄
  comment   String?
  createdAt DateTime @default(now())

  session TherapySession @relation(fields: [sessionId], references: [id])

  @@map("therapy_feedback")
}

// ─── REBOOKING (therapist-initiated) ──────────────

model TherapyRebookingRequest {
  id              String    @id @default(uuid()) @db.Uuid
  therapistId     String    @db.Uuid
  patientId       String    @db.Uuid
  bookingId       String?   @unique @db.Uuid
  suggestedDate   DateTime
  suggestedTime   String
  sessionType     String    @default("followup")
  message         String?
  status          String    @default("pending")
  expiresAt       DateTime
  respondedAt     DateTime?
  notifiedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  therapist TherapyTherapist @relation(fields: [therapistId], references: [id])
  patient   TherapyPatient   @relation(fields: [patientId], references: [id])
  booking   TherapyBooking?  @relation(fields: [bookingId], references: [id])

  @@map("therapy_rebooking_requests")
}

// ─── DISCOUNT CODES ───────────────────────────────

model DiscountCode {
  id            String    @id @default(uuid()) @db.Uuid
  code          String    @unique
  discountType  String // percentage | fixed | full
  discountValue Decimal   @db.Decimal(10, 2)
  maxUses       Int?
  usedCount     Int       @default(0)
  expiresAt     DateTime?
  isActive      Boolean   @default(true)
  createdBy     String?   @db.Uuid
  createdAt     DateTime  @default(now())

  uses DiscountCodeUse[]

  @@map("discount_codes")
}

model DiscountCodeUse {
  id          String   @id @default(uuid()) @db.Uuid
  codeId      String   @db.Uuid
  bookingId   String   @db.Uuid
  usedAt      DateTime @default(now())
  savedAmount Decimal  @db.Decimal(10, 2)

  code    DiscountCode   @relation(fields: [codeId], references: [id], onDelete: Cascade)
  booking TherapyBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("discount_code_uses")
}

// ─── EARNINGS SPLIT (per therapist) ───────────────

model EarningsConfig {
  id               String   @id @default(uuid()) @db.Uuid
  therapistId      String   @unique @db.Uuid
  therapistPercent Decimal  @db.Decimal(5, 2)
  platformPercent  Decimal  @db.Decimal(5, 2)
  effectiveFrom    DateTime @default(now())
  setByAdminId     String?  @db.Uuid
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  therapist TherapyTherapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)

  @@map("earnings_config")
}

// ─── CHAT (patient ↔ therapist, encrypted content) ─

model ChatThread {
  id           String    @id @default(uuid()) @db.Uuid
  patientId    String    @db.Uuid
  therapistId  String    @db.Uuid
  status       String    @default("active") // active | paused | closed | pending_deletion | deleted
  consentGiven Boolean   @default(false)
  consentAt    DateTime?
  slaPatientMessageId     String?   @db.Uuid
  slaTherapistRemindedAt  DateTime?
  slaAdminNotifiedAt      DateTime?
  deletionScheduledAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  patient   TherapyPatient   @relation(fields: [patientId], references: [id])
  therapist TherapyTherapist @relation(fields: [therapistId], references: [id])
  messages  ChatMessage[]
  auditLogs ChatAuditLog[]

  @@unique([patientId, therapistId])
  @@map("chat_threads")
}

model ChatMessage {
  id          String    @id @default(uuid()) @db.Uuid
  threadId    String    @db.Uuid
  senderId    String    @db.Uuid
  senderRole  String
  content     String
  contentIv   String
  isRead      Boolean   @default(false)
  readAt      DateTime?
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  riskLevel   String?
  riskType    String?
  riskScanned Boolean   @default(false)
  isFlagged   Boolean   @default(false)
  flaggedAt   DateTime?
  flagReason  String?
  isResolved      Boolean   @default(false)
  resolvedAt      DateTime?
  resolvedBy      String?   @db.Uuid
  resolutionNote  String?
  highRiskEscalatedAt DateTime?
  createdAt   DateTime  @default(now())

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

model ConsentRecord {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @db.Uuid
  bookingId   String?  @db.Uuid
  consentType String
  consentedAt DateTime @default(now())
  ipAddress   String?
  userAgent   String?
  version     String   @default("1.0")

  @@index([userId])
  @@index([bookingId])
  @@map("consent_records")
}

model ChatAuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  threadId   String   @db.Uuid
  actorId    String   @db.Uuid
  actorRole  String
  action     String
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@map("chat_audit_logs")
}

model ChatConsent {
  id             String   @id @default(uuid()) @db.Uuid
  patientId      String   @db.Uuid
  consentType    String
  consentGiven   Boolean
  consentVersion String   @default("1.0")
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  patient TherapyPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("chat_consents")
}

// ─── REFERRAL PARTNERS ────────────────────────────

model ReferralPartner {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  contactName     String
  email           String   @unique
  phone           String
  address         String?
  city            String
  referralCode    String   @unique
  referralSlug    String   @unique
  tier            String   @default("standard")
  feePerSession   Decimal  @default(3000) @db.Decimal(10, 2)
  bankName        String?
  accountNumber   String?
  accountName     String?
  isActive        Boolean  @default(true)
  totalReferred   Int      @default(0)
  totalEarned     Decimal  @default(0) @db.Decimal(10, 2)
  totalPaid       Decimal  @default(0) @db.Decimal(10, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  referrals ReferralSession[]
  payouts   ReferralPayout[]
  bookings  TherapyBooking[]

  @@map("referral_partners")
}

model ReferralSession {
  id           String   @id @default(uuid()) @db.Uuid
  partnerId    String   @db.Uuid
  bookingId    String   @unique @db.Uuid
  patientEmail String
  feeAmount    Decimal  @db.Decimal(10, 2)
  status       String   @default("pending")
  payoutId     String?  @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  partner ReferralPartner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  payout  ReferralPayout?  @relation(fields: [payoutId], references: [id])
  booking TherapyBooking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@index([patientEmail])
  @@map("referral_sessions")
}

model ReferralPayout {
  id            String    @id @default(uuid()) @db.Uuid
  partnerId     String    @db.Uuid
  amount        Decimal   @db.Decimal(10, 2)
  sessionCount  Int
  status        String    @default("pending")
  bankName      String?
  accountNumber String?
  accountName   String?
  reference     String?
  paidAt        DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  partner  ReferralPartner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  sessions ReferralSession[]

  @@index([partnerId])
  @@index([status])
  @@map("referral_payouts")
}
